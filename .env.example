# OpenRouter / AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Google Places API (New) + Routes API (New)
# Enable in Google Cloud: "Places API (New)" and optionally "Routes API"
# Do NOT use application restriction "Websites" for this key —
# the key is used server-side. Prefer "None" for local/dev, or "IP addresses" in production.
# Server-side Places + Routes (do NOT expose to the browser)
# Enable in Google Cloud: Places API (New), and optionally Routes API
GOOGLE_PLACES_API_KEY=

# Interactive Map view uses OpenStreetMap + Leaflet — no map API key required.
# Optional: for Google Maps JS tiles instead of OSM, add a separate browser key:
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Clerk Auth (optional — app works in guest mode without these)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenWeather (optional — for weather-aware suggestions)
OPENWEATHER_API_KEY=

# Forex: GBP→INR uses Frankfurter (ECB) via /api/forex — no key required.

# App URL (for OpenRouter referrer)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production (hereyougo.me / Hostinger):
# - Set NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY + CLERK_SECRET_KEY to pk_live_ / sk_live_
# - Clerk production keys for this app expect Frontend API host clerk.hereyougo.me
# - Add the CNAME records from Clerk Dashboard → Domains (clerk.hereyougo.me must resolve)
# - Add allowed redirect URLs: https://hereyougo.me/* and https://www.hereyougo.me/*

# Maya widget backend (server-only). Browser hits same-origin /api/maya which
# proxies to this URL. On Hostinger: set MAYA_BACKEND_URL to the current
# Cloudflare quick tunnel. When the tunnel rotates, update ONLY this env
# (Hostinger panel or .env) — do not change layout.tsx or the widget HTML.
MAYA_BACKEND_URL=https://creativity-amount-spot-poet.trycloudflare.com
